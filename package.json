{
  "name": "@rom-manager/editor",
  "version": "0.1.0",
  "description": "Embeddable ROM metadata editor - like mp3tag for video game ROMs",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:lib": "tsup",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "dataset:fetch-dat": "node --use-system-ca --use-env-proxy scripts/download-dats.mjs",
    "dataset:fetch-covers": "node --use-system-ca --use-env-proxy scripts/fetch-covers.mjs",
    "dataset:to-json": "node --use-system-ca --use-env-proxy --import ./scripts/ts-imports.mjs scripts/build-datasets.mjs --skip-download",
    "dataset:json-to-sqlite": "node scripts/json-to-sqlite.mjs",
    "dataset:sample": "node scripts/create-sample-datasets.mjs"
  },
  "dependencies": {
    "@cloudauthn/vfs-sync": "^0.1.24",
    "hash-wasm": "^4.12.0",
    "preact": "^10.24.2",
    "preact-router": "^4.1.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@preact/signals": "^1.3.0",
    "@types/node": "^22.5.4",
    "oxc": "^1.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
